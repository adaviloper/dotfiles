layout {
  cwd "{{ .chezmoi.homeDir }}/Code/neorg/"

  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="Work" cwd="{{ .chezmoi.homeDir }}/Code/neorg/notes" {
    pane
  }

  tab name="Templates" cwd="{{ .chezmoi.homeDir }}/Code/neorg/templates" {
    pane
  }

  tab name="Task Manager" cwd="{{ .chezmoi.homeDir }}/Code/tasks/" {
    pane {
      command "tuxedo"
    }
  }
}
