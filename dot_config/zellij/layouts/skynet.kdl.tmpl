layout {
  cwd "{{ .chezmoi.homeDir }}/Code/suralink/"

  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="Document Search" cwd="{{ .chezmoi.homeDir }}/Code/suralink/document_search" {
    pane
  }

  tab name="AI" cwd="{{ .chezmoi.homeDir }}/Code/suralink/ai_doc_service" {
    pane
  }
}
